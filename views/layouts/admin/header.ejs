    <style>
        #contentToDownload {
            display: none;
            /* Hide this div by default; it will be used for PDF generation */
        }
            .admin-dashboard {
        background: #f5f6f8;
        min-height: 100vh;
        padding: 35px 0;
    }

    .dashboard-title {
        font-size: 26px;
        font-weight: 700;
        color: #252a34;
        margin-bottom: 5px;
    }

    .dashboard-subtitle {
        color: #89909b;
        font-size: 14px;
    }

    .dashboard-card {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.04);
        height: 100%;
    }

    .dashboard-card h5 {
        font-size: 15px;
        font-weight: 600;
        color: #555e6c;
    }

    .dashboard-card h3 {
        font-size: 27px;
        font-weight: 700;
        color: #252a34;
        margin-top: 12px;
    }

    .dashboard-section-title {
        font-size: 19px;
        font-weight: 700;
        color: #252a34;
    }

    .dashboard-filter {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.04);
    }

    .dashboard-filter label {
        font-size: 13px;
        font-weight: 600;
        color: #555e6c;
        margin-bottom: 7px;
    }

    .dashboard-filter .form-control {
        height: 42px;
        border-radius: 7px;
        border: 1px solid #e3e6eb;
        font-size: 13px;
    }

    .dashboard-btn {
        background: #252a34;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 11px 24px;
        font-weight: 600;
    }

    .dashboard-btn:hover {
        background: #424b5a;
        color: #fff;
    }

    .dashboard-chart {
        min-height: 350px;
    }

    .best-selling-card {
        background: #fff;
        border-radius: 12px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 3px 15px rgba(0,0,0,0.04);
    }

    .best-selling-card h4 {
        font-size: 16px;
        font-weight: 700;
        color: #252a34;
        margin-bottom: 20px;
    }

    .best-selling-card .list-group-item {
        border: none;
        border-bottom: 1px solid #f0f1f3;
        padding: 15px 5px;
        font-size: 13px;
        color: #444c58;
    }

    .best-selling-card .badge {
        background: #e8f5ed !important;
        color: #25834a !important;
        font-size: 11px;
        padding: 7px 12px;
    }

    .dashboard-error {
        color: #dc3545;
        font-size: 12px;
    }
    </style>
</head>

